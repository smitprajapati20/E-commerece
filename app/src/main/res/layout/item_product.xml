<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="@dimen/_15sdp"
    android:outlineAmbientShadowColor="#282828"
    android:outlineSpotShadowColor="#282828"
    android:elevation="@dimen/_8sdp"
    app:cardBackgroundColor="#F5F5F5"
    android:layout_marginHorizontal="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/p_img"
            android:layout_width="@dimen/_123sdp"
            android:layout_height="@dimen/_123sdp"
            android:layout_margin="@dimen/_8sdp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/p_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="product Name"
                android:textSize="@dimen/_14sdp"
                android:layout_marginVertical="@dimen/_7sdp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Original Price"
                android:id="@+id/o_rate"
                android:alpha="0.5"
                android:layout_marginVertical="@dimen/_7sdp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discounted Price"
                android:textSize="@dimen/_14sdp"
                android:id="@+id/d_rate"
                android:layout_marginBottom="@dimen/_7sdp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="rating"
                android:textSize="@dimen/_14sdp"
                android:id="@+id/rating"/>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>